<?xml version = "1.0"?>
<robot name = "arm_3dof">

  <!--Colors for links and joints-->
  <material name = "red">
    <color rgba = "0.8 0.1 0.1 1"/>
  </material>

  <material name = "blue">
    <color rgba = "0.1 0.1 0.8 1"/>
  </material>

  <material name = "yellow">
    <color rgba = "1.0 1.0 0 1"/>
  </material>

  <material name = "green">
    <color rgba = "0.1 0.8 0.1 1"/>
  </material>


  <!--Base link-->
  <link name = "base_link">
    <visual>
      <geometry>
        <cylinder radius = "0.15" length = "0.1"/>
      </geometry>

      <origin xyz = "0 0 0" rpy = "0 0 0" />

      <material name = "blue"/>
    </visual>  
  </link>

  <!--Link 1-->
  <link name = "link1">
    <visual>
      <geometry>
        <box size = "0.1 0.1 0.5"/>
      </geometry>

      <origin xyz = "0 0 0.25" rpy = "0 0 0"/>

      <material name = "red"/>
    </visual>
  </link>

  <!--Link 2-->
  <link name = "link2">
    <visual>
      <geometry>
        <box size = "0.1 0.1 0.4"/>
      </geometry>

      <origin xyz = "0 0 0.2" rpy = "0 0 0"/>

      <material name = "green"/>
    </visual>
  </link>

  <!--Link 3-->
  <link name = "link3">
    <visual>
      <geometry>
        <box size = "0.08 0.08 0.3"/>
      </geometry>

      <origin xyz = "0 0 0.15" rpy = "0 0 0"/>

      <material name = "yellow"/>
    </visual>
  </link>

  <!--End effector link-->
  <link name = "end_effector">
    <visual>
      <geometry>
        <box size = "0.15 0.15 0.1"/>
      </geometry>

      <origin xyz = "0 0 0.05" rpy = "0 0 0"/>

      <material name = "yellow"/>
    </visual>
  </link>

  <!--Base Joint-->
  <joint name = "joint1" type = "revolute">
    <parent link = "base_link"/>
    <child link = "link1"/>

    <origin xyz = "0 0 0.05" rpy = "0 0 0"/>

    <axis xyz = "0 0 1"/>

    <limit lower = "-3.14" upper = "3.14" effort = "10" velocity = "1"/>
  </joint>

  <!--Joint 2-->
  <joint name = "joint2" type = "revolute">
    <parent link = "link1"/>
    <child link = "link2"/>

    <origin xyz = "0 0 0.5" rpy = "0 0 0"/>

    <axis xyz = "0 1 0"/>

    <limit lower = "-1.57" upper = "1.57" effort = "10" velocity = "1"/>
  </joint>

  <!--Joint 3-->
  <joint name = "joint3" type = "revolute">
    <parent link = "link2"/>
    <child link = "link3"/>

    <origin xyz = "0 0 0.4" rpy = "0 0 0"/>

    <axis xyz = "0 1 0"/>

    <limit lower = "-1.57" upper = "1.57" effort = "10" velocity = "1"/>
  </joint>

  <!--End effector joint-->
  <joint name = "gripper_joint" type = "fixed">
    <parent link = "link3"/>
    <child link = "end_effector"/>
    <origin xyz = "0 0 0.3" rpy = "0 0 0"/>
  </joint>

</robot>
